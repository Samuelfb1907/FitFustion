# Vorlage fuer die Umgebungsvariablen. Kopiere diese Datei zu ".env" und trage echte Werte ein.
# (.env selbst wird nicht eingecheckt.)

EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-PUBLIC-KEY

# ExerciseDB-GIF-Proxy aktiv (1 = App nutzt die Edge Function statt eines RapidAPI-Keys im Client)
EXPO_PUBLIC_EXERCISEDB_PROXY=1

# RevenueCat (In-App-Kaeufe), oeffentliche SDK-Schluessel (kein Geheimnis).
# Zum Testen reicht der gemeinsame Test-Store-Schluessel:
EXPO_PUBLIC_REVENUECAT_KEY=test_DEIN-TEST-STORE-KEY
# Fuer den echten Store-Build die plattform-spezifischen Schluessel eintragen (haben Vorrang):
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_DEIN-IOS-KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_DEIN-ANDROID-KEY
