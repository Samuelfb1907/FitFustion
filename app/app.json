{
  "expo": {
    "name": "FitAvo",
    "slug": "app",
    "version": "1.0.0",
    "scheme": "fitavo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "FitAvo nutzt die Kamera, um Barcodes von Lebensmitteln zu scannen."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnect",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1216"
          }
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "FitAvo nutzt deine Schrittdaten, um deine Aktivität aufs Tagesziel anzurechnen."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samuelfb1907.fitavo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samuelfb1907.fitavo",
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75146814-4f6b-45f6-8928-dbb2004f15c8"
      }
    },
    "owner": "samuelfb1907"
  }
}
