{
  "expo": {
    "name": "FitAvo",
    "slug": "app",
    "version": "1.1.0",
    "scheme": "fitavo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75146814-4f6b-45f6-8928-dbb2004f15c8",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "FitAvo nutzt die Kamera, um Barcodes zu scannen, Mahlzeiten zu fotografieren und Fortschritts-Fotos aufzunehmen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitAvo nutzt deine Fotos, um eine Mahlzeit auf einem Bild zu erkennen und Fortschritts-Fotos hinzuzufügen."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnect",
      "./plugins/withAndroidLintFix",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1216"
          }
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "FitAvo nutzt deine Schrittdaten, um deine Aktivität aufs Tagesziel anzurechnen."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLATZHALTER"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samuelfb1907.fitavo",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samuelfb1907.fitavo",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75146814-4f6b-45f6-8928-dbb2004f15c8"
      }
    },
    "owner": "samuelfb1907"
  }
}
